// Sociedades que podés crear (§8.2 de docs/DISENO.md). Cada una tiene su propio libro, CUIT e impuestos
// (siempre Responsable Inscripto: IVA, Ingresos Brutos, Seguridad e Higiene y Ganancias de sociedades).
// Las ventas de las actividades que absorbe (las de taxes.json) se le asientan a ella.
// unlock: none · mine40 (nivel 40 de la mina) · fishing6 (pesca 6) · machines5 (5 barriles, conserveras o
// prensas de queso en la granja) · year2 (desde el año 2).
// priceBonus: mejor precio de venta del rubro (venta directa, sin acopiador).
{
  "types": [
    { "id": "agropecuaria",     "activities": ["agro"],      "unlock": "none",      "priceBonus": 0.05, "ticker": "AGRO", "pe": 9 },
    { "id": "minera",           "activities": ["mineria"],   "unlock": "mine40",    "priceBonus": 0.08, "ticker": "MINA", "pe": 8 },
    { "id": "pesquera",         "activities": ["pesca"],     "unlock": "fishing6",  "priceBonus": 0.08, "ticker": "PESC", "pe": 9 },
    { "id": "industrial",       "activities": ["artesanal"], "unlock": "machines5", "priceBonus": 0.06, "ticker": "INDU", "pe": 12 },
    { "id": "comercializadora", "activities": [],            "unlock": "year2",     "priceBonus": 0, "exports": true, "ticker": "COME", "pe": 10 }
  ],

  // Formas societarias: capital mínimo y tasa de inscripción (oro del año 1, se indexan por el IPC).
  "forms": [
    { "id": "SRL", "minimumCapital": 5000,  "registrationFee": 500 },
    { "id": "SA",  "minimumCapital": 20000, "registrationFee": 1500, "canListOnMarket": true }
  ],

  // Transformar una S.R.L. en S.A. (además de completar el capital mínimo).
  "transformationFee": 1000,

  // Tasa de fiscalización de la Inspección de Personas Jurídicas, por estación.
  "seasonalFee": 100,

  // Días con deudas en gestión de cobro hasta la quiebra de la sociedad (÷ "bankruptcySpeed" de la dificultad).
  "insolvencyAfterDays": 28,

  // Mercado de capitales de tus S.A. (ticker y P/E de cada tipo arriba).
  // IPO: acciones iniciales, descuento de colocación, comisión, parte mínima/máxima en manos del público.
  // Recompra con prima y colocación posterior con descuento. ON: plazos (estaciones), mínimo y gastos de colocación;
  // el máximo es (facturación anual + patrimonio) × el factor de la calificación de legal.json.
  "capitalMarket": {
    "ipoShares": 100000,
    "ipoDiscount": 0.10,
    "underwritingFee": 0.03,
    "minFloat": 0.10,
    "maxFloat": 0.49,
    "buybackPremium": 0.15,
    "followOnDiscount": 0.05,
    "minRating": "B",
    "epsFloor": 0.01,
    "volatility": 0.03,
    "meanReversion": 0.05,
    "bondTerms": [4, 8],
    "bondMinimum": 1000,
    "bondFee": 0.02
  }
}
