// Reglas de BYMZ y del ALyC Valle Inversiones (§10 de docs/DISENO.md).
{
  // Costos de cada operación (sobre el monto bruto). El IVA se cobra sobre la comisión.
  "commissionRate": 0.005,
  "minimumCommission": 1,
  "marketFeeRate": 0.0008,
  "commissionIvaRate": 0.21,

  // Spread bid/ask del creador de mercado e impacto de las órdenes grandes
  // (impacto = impactCoefficient × cantidad / volumen diario típico, hasta maxImpact).
  "stockSpread": 0.005,
  "letraSpread": 0.002,
  "impactCoefficient": 0.1,
  "maxImpact": 0.10,

  // Retención sobre dividendos (pago único y definitivo para personas humanas).
  "dividendWithholding": 0.07,

  // Piso de la tasa de referencia (la fija el BCRF; realRate quedó de la Fase 3 y ya no se usa).
  "realRate": 0.005,
  "minimumRate": 0.001,

  // BCRF: regla de Taylor mensual = inflación esperada + neutralRealRate + phi × (inflación − meta).
  // La meta es inflationMin de la dificultad. Se mueve como máximo maxStep por reunión (una por estación).
  "centralBank": {
    "neutralRealRate": 0.004,
    "phi": 0.5,
    "floor": 0.002,
    "maxStep": 0.02,
    "emissionHike": 0.01
  },

  // Curva: rendimiento mensual = tasa de política + prima por plazo + spread de la calificación del emisor.
  "termPremium": [
    { "days": 1,    "premium": 0.0 },
    { "days": 28,   "premium": 0.0 },
    { "days": 112,  "premium": 0.003 },
    { "days": 224,  "premium": 0.005 },
    { "days": 448,  "premium": 0.008 },
    { "days": 1344, "premium": 0.012 }
  ],

  // Bonos y ON: spread bid/ask y el bono que se entrega en un canje (cupón por estación, plazo y cuotas).
  "bondSpread": 0.003,
  "restructuredCoupon": 0.005,
  "restructuredTenor": 12,
  "restructuredInstallments": 4,

  // Letras del Tesoro de Ferngill (LEFE): cupón cero, VN 100, se licitan al empezar cada estación.
  // La tasa sale de la curva (más el riesgo país); "premium" quedó de la Fase 3 y ya no se usa.
  "letraTenors": [
    { "days": 28,  "premium": 0.0 },
    { "days": 56,  "premium": 0.002 },
    { "days": 112, "premium": 0.005 }
  ],
  "letraFaceValue": 100,

  // Cauciones colocadoras: plazos en días, tasa = caucionRateFactor × tasa de referencia, monto mínimo.
  "caucionTerms": [1, 7, 14, 28],
  "caucionRateFactor": 0.85,
  "caucionMinimum": 100,

  // Derivados (MATZU y opciones). Garantías: inicial sobre el nocional (× volatilidad de la dificultad) y mínima
  // como fracción de la inicial. Opciones: lote de 10 acciones, ejercicios alrededor del precio actual.
  "derivatives": {
    "futuresMaturities": 3,
    "futuresSpread": 0.002,
    "futuresCommissionRate": 0.001,
    "initialMargin": 0.15,
    "maintenanceRatio": 0.75,
    "deliveryPenalty": 0.20,
    "silverPremium": 0.10,
    "goldPremium": 0.20,
    "iridiumPremium": 0.40,
    "optionLot": 10,
    "optionMaturities": 2,
    "optionStrikes": [0.90, 0.95, 1.00, 1.05, 1.10],
    "optionSpread": 0.03,
    "optionCommissionRate": 0.005,
    "shortOptionMarginRate": 0.20,
    "shortOptionMinimumRate": 0.10
  },

  "merzuBase": 1000,
  "intradayTicks": 48
}
